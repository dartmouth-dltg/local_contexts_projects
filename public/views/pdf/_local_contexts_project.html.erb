<%# fetch the lc data for this project #%>
<% 
  lcp = ArchivesSpaceClient.instance.get_data_from_local_contexts_api(project_id, "project", true)
  current_date = Time.now.strftime("%B %d, %Y")
  lc_labels = ["bc_labels", "tk_labels"]
  # Everything below comes from the Local Contexts API, so it is escaped by
  # ERB. Urls are also limited to http(s): the PDF renderer fetches image urls.
  http_url = lambda {|url| url.to_s =~ %r{\Ahttps?://}i ? url.to_s : nil }
  project_url = File.join(AppConfig[:local_contexts_base_url], 'projects', project_id)
  community_name = lambda {|item| c = item['community']; c = c['name'] if c.is_a?(Hash); c.to_s.empty? ? nil : c.to_s }
  translations = lambda {|item| Array(item['translations']).select {|t| t.is_a?(Hash) } }
%>

<%# no lists here: the core PDF stylesheet draws a bullet before every li (li::before) %>
<div class="local-contexts-project">
    <p style="font-size: 0.8em; margin-top: 0.5em">
      <%= I18n.t("local_contexts_project_date_information") %><%= current_date %>. <%= I18n.t("local_contexts_project_date_see_current") %>
    </p>
    <% if lcp['title'] %>
      <p style="font-size: 0.8em; margin-top: 0.5em"><b><%= lcp['title'] %></b></p>
      <p style="font-size: 0.8em; margin-top: 0.5em">
        <a href="<%= http_url.call(lcp['project_page']) || project_url %>"><%= I18n.t("local_contexts_project_link_text") %> (Project ID: <%= project_id %>)</a>
      </p>
      <% lcp.each do |k,v| %>
        <% if lc_labels.include?(k) %>
          <% v.each do |label| %>
            <p style="font-size: 0.8em; margin-top: 0.5em"><%= label['name'] %> (<%= label['language'] %>)</p>
            <% if http_url.call(label['img_url']) %>
              <p style="font-size: 0.8em; margin-top: 0.5em"><img style="height: 3em" src="<%= http_url.call(label['img_url']) %>" /></p>
            <% end %>
            <p style="font-size: 0.8em; margin-top: 0.5em"><%= label['label_text'] %></p>
            <% if community_name.call(label) %>
              <p style="font-size: 0.8em; margin-top: 0.5em"><b>Placed By</b>: <%= community_name.call(label) %></p>
            <% end %>
            <% if translations.call(label).length > 0 %>
              <% translations.call(label).each do |translation| %>
                <p style="font-size: 0.8em; margin-top: 0.5em"><%= translation['translated_name'] %> (<%= translation['language'] %>)</p>
                <p style="font-size: 0.8em; margin-top: 0.5em"><%= translation['translated_text'] %></p>
              <% end %>
            <% end %>
          <% end %>
        <%# notices #%>
        <% elsif k == 'notice' %>
          <% v.each do |notice| %>
            <p style="font-size: 0.8em; margin-top: 0.5em"><%= notice['name'] %></p>
            <% if http_url.call(notice['img_url']) %>
              <p style="font-size: 0.8em; margin-top: 0.5em"><img style="height: 3em" src="<%= http_url.call(notice['img_url']) %>" /></p>
            <% end %>
            <p style="font-size: 0.8em; margin-top: 0.5em"><%= notice['default_text'] %></p>
            <% if translations.call(notice).length > 0 %>
              <% translations.call(notice).each do |translation| %>
                <p style="font-size: 0.8em; margin-top: 0.5em"><%= translation['translated_name'] %> (<%= translation['language'] %>)</p>
                <p style="font-size: 0.8em; margin-top: 0.5em"><%= translation['translated_text'] %></p>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <%# render error message if the project could not be fetched #%>
    <% else %>
      <p style="font-size: 0.8em; margin-top: 0.5em"><%= I18n.t("local_contexts_project.fetch_error.ead_message") %></p>
      <p style="font-size: 0.8em; margin-top: 0.5em"><a href="<%= project_url %>"><%= I18n.t("local_contexts_project_link_text") %> (Project ID: <%= project_id %>)</a></p>
    <% end %>
</div>


          